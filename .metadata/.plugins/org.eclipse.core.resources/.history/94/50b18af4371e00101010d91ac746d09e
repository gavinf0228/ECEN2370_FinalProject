#include "Game_Driver.h"

void GameDrawBoard(){

    for (int r = 0; r < ROWS; ++r) {
        for (int c = 0; c < COLUMNS; ++c) {
            uint16_t x = 30 + c *30;
            uint16_t y = 120 + r * 30;
            LCD_Draw_Circle_Fill(x, y, 10, LCD_COLOR_GREY);

            uint16_t left = x - 12;
            uint16_t right = x +12;
            uint16_t top = y - 12;
            uint16_t bottom = y + 12;

            for (int i = 0; i <= 24; ++i){
                LCD_Draw_Vertical_Line(left + 1, top, 1, LCD_COLOR_BLACK);
                LCD_Draw_Vertical_Line(left + i, bottom, 1, LCD_COLOR_BLACK);

            }
            LCD_Draw_Vertical_Line(left, top - 1, 26, LCD_COLOR_BLACK);
            LCD_Draw_Vertical_Line(right, top - 1, 26, LCD_COLOR_BLACK);

        }
    }
}
